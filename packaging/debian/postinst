#!/bin/sh
# Register the Win+Shift+S hotkey right away for whoever is logged in.
# Everyone else gets it at their next login via /etc/xdg/autostart.
set -e

if [ "$1" = "configure" ]; then
    if command -v update-desktop-database >/dev/null 2>&1; then
        update-desktop-database -q /usr/share/applications || true
    fi
    if command -v gtk-update-icon-cache >/dev/null 2>&1; then
        gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor || true
    fi
    /usr/libexec/snip-and-sketch/session-hotkey install || true
    echo "Snip & Sketch for Linux: press Shift+Super+S (Win+Shift+S) to snip."
    echo "  Change or remove the hotkey with: snip-hotkey install|remove|status"
fi

exit 0
